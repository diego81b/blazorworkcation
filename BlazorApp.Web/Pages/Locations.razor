@page "/locations"
@using BlazorApp.Web.Models
@using BlazorApp.Web.Shared

<SearchFilters></SearchFilters>
<div class="px-2 py-2 xl:flex-1 xl:overflow-x-hidden">
    @if (locations == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @for (var i = 0; i < locations.Count; i++)
        {
            <div class="@(i > 0 ? "mt-6": "")">
                <div class="px-4 xl:px-8">
                    <h3 class="text-gray-900 text-xl">@locations[i]?.Title</h3>
                    <p class="text-gray-600">@locations[i]?.Description</p>
                </div>
                <div class="mt-6 sm:overflow-x-auto sm:overflow-y-hidden">
                    <div class="px-4 sm:inline-flex sm:pt-2 sm:pb-8 xl:px-8">
                        @for (var k = 0; k < locations[i].Properties.Count; k++)
                        {
                            <div class="@(k > 0 ? "mt-10 sm:ml-4":"")  sm:mt-0 sm:w-80 sm:flex-shrink-0">
                                <PropertyCard Property="locations[i].Properties[k]"></PropertyCard>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

